---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import PosterSlot from '../../components/ui/PosterSlot.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import ShareLinks from '../../components/ui/ShareLinks.astro';
import { events } from '../../data/events';
import { org } from '../../data/site';

export function getStaticPaths() {
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;
const isUpcoming = event.status === 'upcoming';
const other = events.filter((item) => item.slug !== event.slug);
const pageUrl = new URL(`/events/${event.slug}/`, Astro.site).href;

// Events run for an evening unless the data says otherwise, so a three-hour
// block is a sane default for the calendar entry.
const start = new Date(event.startDate);
const end = new Date(start.getTime() + 3 * 60 * 60 * 1000);
const stamp = (date: Date) => date.toISOString().replace(/[-:]|\.\d{3}/g, '');
const calendarHref =
  'https://calendar.google.com/calendar/render?action=TEMPLATE&' +
  new URLSearchParams({
    text: `${event.title} | Zinduka Hub`,
    dates: `${stamp(start)}/${stamp(end)}`,
    details: `${event.description}\n\n${pageUrl}`,
    location: event.location,
  }).toString();

const schema = [
  {
    '@type': 'Event',
    name: event.title,
    startDate: event.startDate,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    description: event.about ?? event.description,
    url: pageUrl,
    location: {
      '@type': 'Place',
      name: event.location,
      address: {
        '@type': 'PostalAddress',
        addressLocality: org.address.locality,
        addressRegion: org.address.region,
        addressCountry: org.address.country,
      },
    },
    organizer: { '@id': `${org.url}/#organization` },
    offers: {
      '@type': 'Offer',
      url: event.bookingUrl,
      availability: 'https://schema.org/InStock',
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: org.url },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Events',
        item: `${org.url}/events/`,
      },
      { '@type': 'ListItem', position: 3, name: event.title },
    ],
  },
];

const facts = [
  { icon: 'calendar' as const, label: 'Date', value: event.date },
  ...(event.time
    ? [{ icon: 'calendar' as const, label: 'Time', value: event.time }]
    : []),
  { icon: 'venue' as const, label: 'Venue', value: event.location },
  ...(event.track
    ? [{ icon: 'users' as const, label: 'For', value: event.track }]
    : []),
];
---

<Layout
  title={`${event.title} | Zinduka Hub`}
  description={event.about ?? event.description}
  schema={schema}
>
  <Header />
  <main id="main">
    <section class="bg-brand px-6 pt-32 pb-16 text-white sm:px-10 sm:pt-36 sm:pb-20">
      <div class="mx-auto max-w-page">
        <div class="[&_a]:text-white/70 [&_a:hover]:text-white [&_ol]:text-white/60 [&_span]:text-white/40">
          <Breadcrumbs
            trail={[
              { label: 'Events', href: '/events' },
              { label: event.title },
            ]}
          />
        </div>
        <p class="mt-6 font-ui text-sm font-medium text-white/70">
          {isUpcoming ? 'Upcoming event' : 'Past event'}
        </p>
        <h1 class="mt-3 max-w-3xl heading-display">{event.title}</h1>
        <dl class="mt-10 grid gap-6 border-t border-white/15 pt-8 sm:grid-cols-2 lg:grid-cols-4">
          {facts.map((fact) => (
            <div class="flex items-start gap-3">
              <Icon name={fact.icon} size={18} class="mt-1 text-white/60" />
              <div>
                <dt class="font-ui text-xs font-medium text-white/60">
                  {fact.label}
                </dt>
                <dd class="mt-1 text-sm leading-7 text-white">{fact.value}</dd>
              </div>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="bg-paper px-6 py-16 sm:px-10 sm:py-20 lg:py-24">
      <div class="mx-auto grid max-w-page gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-16">
        <div>
          <h2 class="heading-1 text-ink">About this event</h2>
          <p class="mt-5 text-base leading-8 font-medium text-ink/70">
            {event.description}
          </p>
          {event.about && (
            <p class="mt-5 text-base leading-8 text-ink/70">{event.about}</p>
          )}

          {event.details && event.details.length > 0 && (
            <div class="mt-12">
              <h2 class="heading-2 text-ink">What to expect</h2>
              <ul class="mt-5 space-y-3">
                {event.details.map((detail) => (
                  <li class="flex items-start gap-3 text-sm leading-7 text-ink/70">
                    <Icon
                      name="star"
                      size={17}
                      class="mt-1 shrink-0 text-brand"
                    />
                    <span>{detail}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {event.schedule && event.schedule.length > 0 && (
            <div class="mt-12 border-t border-ink/10 pt-10">
              <h2 class="heading-2 text-ink">Running order</h2>
              <p class="mt-3 text-sm leading-7 text-ink/50">
                Times are indicative. Things shift on the day.
              </p>
              <dl class="mt-6">
                {event.schedule.map((slot) => (
                  <div class="flex gap-6 border-t border-ink/10 py-4 first:border-t-0">
                    <dt class="w-20 shrink-0 font-ui text-sm font-medium tabular-nums text-brand">
                      {slot.time}
                    </dt>
                    <dd class="text-sm leading-7 text-ink/70">{slot.item}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}

          {event.notes && event.notes.length > 0 && (
            <div class="mt-12 border-t border-ink/10 pt-10">
              <h2 class="heading-2 text-ink">Before you come</h2>
              <dl class="mt-6 grid gap-6 sm:grid-cols-2">
                {event.notes.map((note) => (
                  <div>
                    <dt class="font-ui text-xs font-medium text-ink/45">
                      {note.label}
                    </dt>
                    <dd class="mt-1 text-sm leading-7 text-ink/70">
                      {note.value}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          )}

          <div class="mt-12 border-t border-ink/10 pt-10">
            <h2 class="heading-2 text-ink">Getting there</h2>
            <p class="mt-4 flex items-start gap-3 text-sm leading-7 text-ink/70">
              <Icon name="venue" size={18} class="mt-1 shrink-0 text-brand" />
              <span>
                {event.location}, {org.address.locality}, {org.address.region}.
              </span>
            </p>
            <p class="mt-4 text-sm leading-7 text-ink/60">
              Not sure where to go, or need anything before you arrive?{' '}
              <a
                href="/#contact"
                class="text-brand underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand"
              >
                Send us a message
              </a>{' '}
              and we will get back to you.
            </p>
          </div>

          <div class="mt-12 border-t border-ink/10 pt-10">
            <h2 class="heading-3 text-ink">Share this event</h2>
            <div class="mt-4">
              <ShareLinks url={pageUrl} text={`${event.title} | Zinduka Hub`} />
            </div>
          </div>
        </div>

        <aside class="lg:sticky lg:top-28 lg:self-start">
          <PosterSlot
            poster={event.poster}
            alt={`${event.title} poster`}
            ratio="aspect-[4/5]"
            class="rounded-md border border-ink/10"
          />
          <div class="mt-6 rounded-md border border-ink/10 bg-white p-6">
            {isUpcoming ? (
              <>
                <p class="font-ui text-sm font-medium text-ink">
                  Booking is open
                </p>
                <p class="mt-2 text-sm leading-7 text-ink/60">
                  Reserve your place on our events platform, then add the date
                  to your calendar.
                </p>
                <Button
                  href={event.bookingUrl}
                  icon="arrowRight"
                  external
                  class="mt-5 w-full"
                >
                  Book your place
                </Button>
                <Button
                  href={calendarHref}
                  variant="outline"
                  external
                  class="mt-3 w-full"
                >
                  Add to calendar
                </Button>
              </>
            ) : (
              <>
                <p class="font-ui text-sm font-medium text-ink">
                  This event has passed
                </p>
                <p class="mt-2 text-sm leading-7 text-ink/60">
                  Catch the next one. Upcoming events are listed on the events
                  page.
                </p>
                <Button href="/events" icon="arrowRight" class="mt-5 w-full">
                  See upcoming events
                </Button>
              </>
            )}
          </div>
        </aside>
      </div>
    </section>

    {other.length > 0 && (
      <section class="bg-paper px-6 pb-16 sm:px-10 sm:pb-20">
        <div class="mx-auto max-w-page border-t border-ink/10 pt-12">
          <h2 class="heading-1 text-ink">More events</h2>
          <ul class="mt-8 grid gap-5 sm:grid-cols-2">
            {other.map((item) => (
              <li>
                <a
                  href={`/events/${item.slug}`}
                  class="block h-full rounded-md border border-ink/10 bg-white p-6 transition-colors hover:border-brand/30 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand motion-reduce:transition-none"
                >
                  <p class="font-ui text-xs font-medium text-ink/45">
                    {item.status === 'upcoming' ? 'Upcoming' : 'Past event'}
                  </p>
                  <h3 class="mt-2 heading-2 text-ink">{item.title}</h3>
                  <p class="mt-2 text-sm leading-7 text-ink/60">
                    {item.date}
                    {item.time && ` · ${item.time}`}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </main>
  <Footer />
</Layout>
