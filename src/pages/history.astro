---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PageHero from '../components/sections/PageHero.astro';
import EditionCard from '../components/ui/EditionCard.astro';
import EditionRow from '../components/ui/EditionRow.astro';
import Button from '../components/ui/Button.astro';
import { historyIntro, editionsNewestFirst } from '../data/history';

const [current, ...past] = editionsNewestFirst;

const schema = [
  {
    '@type': 'ItemList',
    name: 'Zinduka Hub editions',
    description: historyIntro,
    itemListElement: editionsNewestFirst.map((edition, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: edition.title,
      description: edition.description,
    })),
  },
];
---

<Layout
  title="Our history | Zinduka Hub"
  description="Eleven editions of Zinduka Hub. A decade of creating space for young ideas to grow, beginning in Chuka."
  schema={schema}
>
  <Header />
  <main id="main">
    <PageHero title="Eleven editions" intro={historyIntro} />

    <section class="bg-paper px-6 pb-16 sm:px-10 sm:pb-20">
      <div class="mx-auto max-w-page">
        {current && <EditionCard edition={current} />}

        {past.length > 0 && (
          <div class="mt-14">
            <h2 class="heading-2 text-ink">Earlier editions</h2>
            <p class="mt-3 max-w-prose text-sm leading-7 text-ink/60">
              {past.length} editions before this one. Open any of them for the
              theme, the story and what happened.
            </p>
            <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {past.map((edition) => (
                <li>
                  <EditionRow edition={edition} />
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>

    <section class="bg-brand px-6 py-16 text-white sm:px-10 sm:py-20">
      <div class="mx-auto flex max-w-page flex-col items-start justify-between gap-8 sm:flex-row sm:items-center">
        <div>
          <h2 class="heading-1">The story continues with 11.0</h2>
          <p class="mt-4 max-w-lg text-base leading-8 text-white/80">
            See what the current edition is building and where you can join in.
          </p>
        </div>
        <Button href="/zinduka-11" variant="white" icon="arrowRight">
          Explore Zinduka 11.0
        </Button>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
