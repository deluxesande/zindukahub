---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PageHero from '../components/sections/PageHero.astro';
import EventCard from '../components/ui/EventCard.astro';
import Button from '../components/ui/Button.astro';
import { upcomingEvents, pastEvents } from '../data/events';
---

<Layout
  title="Events — Zinduka Hub"
  description="See what’s coming up at Zinduka Hub and book your place through our events platform."
>
  <Header />
  <main id="main">
    <PageHero
      eyebrow="What&rsquo;s on"
      title="Events"
      intro="Showcases, exhibitions and meet-ups for creatives, innovators, exhibitors and entrepreneurs. Pick an event and book your place on our events platform."
    />

    <section class="bg-paper px-6 pb-16 sm:px-10 sm:pb-20">
      <div class="mx-auto max-w-[1120px]">
        <h2 class="font-heading text-[34px] leading-tight font-normal tracking-[-0.03em] text-ink sm:text-[40px]">
          Upcoming events
        </h2>
        <div class="mt-8 space-y-6">
          {upcomingEvents.map((event) => (
            <EventCard event={event} />
          ))}
        </div>
      </div>
    </section>

    {pastEvents.length > 0 && (
      <section class="bg-paper px-6 pb-16 sm:px-10 sm:pb-20">
        <div class="mx-auto max-w-[1120px]">
          <div class="border-t border-ink/10 pt-12">
            <h2 class="font-heading text-[34px] leading-tight font-normal tracking-[-0.03em] text-ink sm:text-[40px]">
              Past events
            </h2>
            <div class="mt-8 space-y-6">
              {pastEvents.map((event) => (
                <EventCard event={event} />
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="bg-brand px-6 py-16 text-white sm:px-10 sm:py-20">
      <div class="mx-auto flex max-w-[1120px] flex-col items-start justify-between gap-8 sm:flex-row sm:items-center">
        <div>
          <h2 class="max-w-lg font-heading text-[32px] leading-tight font-normal tracking-[-0.03em] sm:text-[42px]">
            Curious what this season is about?
          </h2>
          <p class="mt-4 max-w-lg text-base leading-8 text-white/80">
            Zinduka 11.0 carries the theme CREATE. EXHIBIT. ENTERPRISE.
          </p>
        </div>
        <Button href="/zinduka-11" variant="white" icon="arrowRight">
          Explore Zinduka 11.0
        </Button>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
