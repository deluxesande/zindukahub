---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import { editions, editionsNewestFirst } from '../../data/history';
import type { IconName } from '../../components/ui/icons';
import { org } from '../../data/site';

export function getStaticPaths() {
  return editions.map((edition) => ({
    params: { slug: edition.slug },
    props: { edition },
  }));
}

const { edition } = Astro.props;
const isCurrent =
  edition.edition === Math.max(...editions.map((e) => e.edition));
const others = editionsNewestFirst.filter((e) => e.slug !== edition.slug);

// One icon per highlight, cycled so any edition's list stays covered.
const highlightIcons: IconName[] = [
  'flag',
  'presentation',
  'buildings',
  'users',
];

const schema = [
  {
    '@type': 'CreativeWork',
    name: edition.title,
    headline: edition.theme,
    description: edition.story ?? edition.description,
    creator: { '@id': `${org.url}/#organization` },
    url: new URL(`/history/${edition.slug}/`, Astro.site).href,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: org.url },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'History',
        item: `${org.url}/history/`,
      },
      { '@type': 'ListItem', position: 3, name: edition.title },
    ],
  },
];
---

<Layout
  title={`${edition.title} | Zinduka Hub`}
  description={edition.story ?? edition.description}
  schema={schema}
>
  <Header />
  <main id="main">
    <section class="bg-brand px-6 pt-32 pb-16 text-white sm:px-10 sm:pt-36 sm:pb-20">
      <div class="mx-auto max-w-page">
        <div class="[&_a]:text-white/70 [&_a:hover]:text-white [&_ol]:text-white/60 [&_span]:text-white/40">
          <Breadcrumbs
            trail={[
              { label: 'History', href: '/history' },
              { label: edition.title },
            ]}
          />
        </div>
        <p class="mt-6 font-ui text-sm font-medium text-white/70">
          {edition.year}
        </p>
        <h1 class="mt-3 max-w-3xl heading-display">{edition.title}</h1>
        <p class="mt-6 max-w-2xl font-ui text-base font-medium text-white/80">
          {edition.theme}
        </p>
      </div>
    </section>

    <section class="bg-paper px-6 py-16 sm:px-10 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-page">
        <div class="grid items-start gap-10 md:grid-cols-2 md:gap-16">
          <div>
            <p class="max-w-prose heading-2 text-ink">{edition.description}</p>
            {isCurrent && (
              <div>
                <Button href="/zinduka-11" icon="arrowRight" class="mt-8">
                  See what is happening now
                </Button>
              </div>
            )}
          </div>
          {edition.story && (
            <p class="max-w-prose text-base leading-8 text-ink/70 md:pt-3">
              {edition.story}
            </p>
          )}
        </div>

        {edition.image && (
          // The edition photo is a cutout: a wide group lineup sitting in the
          // bottom fifth of its frame. A tall column left most of the box
          // empty whatever colour went behind it, so it runs as a wide band
          // cropped to the subject instead.
          <div class="group mt-12 overflow-hidden rounded-md bg-brand sm:mt-16">
            <Image
              src={edition.image}
              alt={`${edition.title} artwork`}
              widths={[900, 1400, 2000]}
              sizes="(max-width: 1320px) 100vw, 1320px"
              width={1800}
              class="aspect-[16/7] w-full object-cover object-bottom grayscale transition-[filter] duration-200 motion-reduce:transition-none sm:aspect-[16/6] [@media(hover:hover)_and_(pointer:fine)]:group-hover:grayscale-0"
            />
          </div>
        )}

        {edition.highlights && edition.highlights.length > 0 && (
          <div class="mt-14 border-t border-ink/10 pt-10 text-center">
            <h2 class="heading-2 text-ink">Highlights</h2>
            <ul class="mt-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
              {edition.highlights.map((highlight, index) => (
                <li class="flex flex-col items-center gap-3">
                  <Icon
                    name={highlightIcons[index % highlightIcons.length]}
                    size={22}
                    class="shrink-0 text-brand"
                  />
                  <span class="max-w-[22ch] text-sm leading-7 text-ink/70">
                    {highlight}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>

    <section class="bg-paper px-6 pb-16 sm:px-10 sm:pb-20 lg:pb-24">
      {edition.openCalls && edition.openCalls.length > 0 && (
        <div class="mx-auto max-w-page">
          <h2 class="heading-2 text-ink">Who this edition is calling for</h2>
          <ul class="mt-8 grid gap-8 sm:grid-cols-2">
            {edition.openCalls.map((call) => (
              <li class="flex flex-col">
                <Image
                  src={call.poster}
                  alt={`${call.title} poster for ${edition.title}`}
                  widths={[400, 700, 1000]}
                  sizes="(max-width: 639px) 90vw, 40vw"
                  width={800}
                  class="w-full rounded-md border border-ink/10"
                />
                <h3 class="heading-3 mt-5 text-brand">{call.title}</h3>
                <p class="mt-2 font-ui text-sm leading-7 font-medium text-ink">
                  {call.audience}
                </p>
                <p class="mt-1 text-sm leading-7 text-ink/70">{call.copy}</p>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>

    {edition.gallery && edition.gallery.length > 0 && (
      <section
        aria-label={`Photographs from ${edition.title}`}
        class="bg-white px-6 py-16 sm:px-10 sm:py-20"
      >
        <div class="mx-auto max-w-page">
          <ul class="grid gap-5 sm:grid-cols-12 sm:auto-rows-[15rem] lg:auto-rows-[19rem]">
            {edition.gallery.map((shot, index) => (
              <li
                class:list={[
                  'group overflow-hidden rounded-md bg-paper',
                  // A mosaic, not a row: wide and narrow cells alternate so the
                  // strip reads as a grid at any count.
                  index % 4 === 0 && 'sm:col-span-8',
                  index % 4 === 1 && 'sm:col-span-4',
                  index % 4 === 2 && 'sm:col-span-4',
                  index % 4 === 3 && 'sm:col-span-8',
                ]}
              >
                <Image
                  src={shot.image}
                  alt={shot.alt}
                  widths={[500, 900, 1400]}
                  sizes="(max-width: 639px) 90vw, (max-width: 1023px) 60vw, 45vw"
                  width={1200}
                  class="aspect-[4/3] h-full w-full object-cover grayscale sm:aspect-auto transition-[filter] duration-200 motion-reduce:transition-none [@media(hover:hover)_and_(pointer:fine)]:group-hover:grayscale-0"
                />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {others.length > 0 && (
      <section class="bg-paper px-6 pb-16 sm:px-10 sm:pb-20">
        <div class="mx-auto max-w-page border-t border-ink/10 pt-12">
          <h2 class="heading-1 text-ink">Other editions</h2>
          <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {others.map((item) => (
              <li>
                <a
                  href={`/history/${item.slug}`}
                  class="block rounded-md border border-ink/10 bg-white p-6 transition-colors hover:border-brand/30 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand motion-reduce:transition-none"
                >
                  <h3 class="heading-2 text-brand">{item.title}</h3>
                  <p class="mt-2 text-sm leading-7 text-ink/60">{item.theme}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </main>
  <Footer />
</Layout>
