---
import { Image } from 'astro:assets';
import hero from '../../assets/images/history-current-edition.png';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
---

<section
  id="home"
  aria-labelledby="hero-heading"
  class="overflow-hidden bg-paper pt-36 sm:pt-40"
>
  <div class="relative z-10 mx-auto max-w-4xl px-5 text-center">
    <h1 id="hero-heading" class="heading-display text-brand">
      A space for young
      <br />
      <em class="font-normal">ideas to grow.</em>
    </h1>
    <p class="mx-auto mt-5 max-w-lg text-base leading-7 font-medium text-ink/70">
      Bringing talent, innovation, and an entrepreneurial spirit together at
      Chuka University.
    </p>
    <Button href={site.partnerHref} class="mt-7">
      Partner with us
    </Button>
  </div>
  {/*
    A cutout with the group in the bottom fifth of a 4:5 frame, so it runs
    as a band cropped from the bottom. At full height it would be mostly
    empty paper.
  */}
  <div class="group mx-auto mt-10 max-w-page px-3 sm:mt-12 sm:px-10">
    <Image
      src={hero}
      alt="The Zinduka Hub community together at a past edition"
      widths={[900, 1400, 2000]}
      sizes="(max-width: 1320px) 100vw, 1320px"
      width={1800}
      quality={85}
      loading="eager"
      fetchpriority="high"
      class="aspect-[16/7] w-full object-cover object-bottom grayscale transition-[filter] duration-200 motion-reduce:transition-none sm:aspect-[16/6] [@media(hover:hover)_and_(pointer:fine)]:group-hover:grayscale-0"
    />
  </div>
</section>
