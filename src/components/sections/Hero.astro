---
import { Image } from 'astro:assets';
import hero from '../../assets/images/history-current-edition.png';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
---

<section
  id="home"
  aria-labelledby="hero-heading"
  class="overflow-hidden bg-paper pt-36 sm:pt-40"
>
  <div class="relative z-10 mx-auto max-w-4xl px-5 text-center">
    <h1 id="hero-heading" class="heading-display text-brand">
      A space for young
      <br />
      <em class="font-normal">ideas to grow.</em>
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-base leading-7 font-medium text-ink/70">
      Starting in Chuka, Zinduka Hub gives young Kenyans a platform, mentorship
      and a path to prove their work, so no good idea is lost because of where
      they live.
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <Button href="/zinduka-11" icon="arrowRight">
        Explore Zinduka 11.0
      </Button>
      <Button href={site.partnerHref} variant="outline">
        Partner with us
      </Button>
    </div>
  </div>
  {/*
    A cutout with the group in the bottom fifth of a 4:5 frame, so it runs
    as a band cropped from the bottom. At full height it would be mostly
    empty paper.
  */}
  <div class="group mx-auto mt-10 max-w-page px-3 sm:mt-12 sm:px-10">
    <Image
      src={hero}
      alt="The Zinduka Hub community together at a past edition"
      widths={[900, 1400, 2000]}
      sizes="(max-width: 1320px) 100vw, 1320px"
      width={1800}
      quality={85}
      loading="eager"
      fetchpriority="high"
      class="aspect-[16/7] w-full object-cover object-bottom sm:aspect-[16/6]"
    />
  </div>
</section>
