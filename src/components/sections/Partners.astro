---
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import { partners } from '../../data/partners';
---

<section
  id="partners"
  aria-labelledby="partners-heading"
  class="scroll-mt-6 bg-white px-6 py-16 sm:px-10 sm:py-20 lg:py-24"
>
  <div class="mx-auto max-w-page">
    <div class="mb-10 grid items-start gap-6 md:grid-cols-2 md:gap-16">
      <SectionHeading id="partners-heading">Our partners</SectionHeading>
      <p class="max-w-prose text-base leading-8 font-medium text-ink/70 md:pt-3">
        The organisations and supporters who make our work possible.
      </p>
    </div>
    <ul class="flex flex-wrap items-center gap-x-10 gap-y-8 sm:gap-x-14">
      {partners.map((partner) => {
        const body = (
          <Image
            src={partner.logo}
            alt={partner.name}
            widths={[240, 480]}
            sizes="(max-width: 767px) 55vw, 280px"
            width={240}
            class={`h-auto w-auto ${partner.size ?? 'max-h-20'}`}
          />
        );

        return (
          <li class="flex items-center">
            {partner.href ? (
              <a
                href={partner.href}
                target="_blank"
                rel="noopener"
                class="flex items-center rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand"
              >
                {body}
              </a>
            ) : (
              body
            )}
          </li>
        );
      })}
    </ul>
  </div>
</section>
