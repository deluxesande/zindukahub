---
import SocialLinks from '../ui/SocialLinks.astro';
---

<section
  id="community"
  aria-labelledby="community-heading"
  class="scroll-mt-6 bg-paper px-6 pb-16 sm:px-10 sm:pb-20 lg:pb-24"
>
  <div class="mx-auto flex max-w-[1120px] flex-col items-start justify-between gap-8 rounded-md border border-ink/10 bg-white p-8 shadow-sm shadow-black/[0.02] sm:flex-row sm:items-center sm:p-10">
    <div>
      <h2
        id="community-heading"
        class="font-heading text-[32px] leading-tight font-normal tracking-[-0.03em] text-brand sm:text-[40px]"
      >
        Join the community
      </h2>
      <p class="mt-4 max-w-md text-sm leading-7 text-ink/70">
        Get event updates and connect with other young people in the Zinduka Hub
        WhatsApp group, or follow along on Instagram.
      </p>
    </div>
    <SocialLinks tone="dark" class="shrink-0" />
  </div>
</section>
