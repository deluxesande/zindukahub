---
import { Image } from 'astro:assets';
import poweredBy from '../../assets/logos/powered-by-Blue.png';
import team from '../../assets/images/aiesec.png';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
---

<section
  id="partnerships"
  aria-labelledby="partnerships-heading"
  class="scroll-mt-6 bg-paper px-6 pb-16 sm:px-10 sm:pb-20 lg:pb-24"
>
  <div class="mx-auto max-w-[1120px]">
    <div class="grid items-end gap-10 md:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div class="max-w-lg md:pb-14 lg:pb-20">
        <SectionHeading id="partnerships-heading">Work with us</SectionHeading>
        <p class="mt-7 text-base leading-8 font-medium text-ink/70">
          Do you share our belief in young people and their ideas? We welcome
          conversations with partners and sponsors who connect with our purpose.
        </p>
        <p class="mt-4 text-sm leading-7 text-ink/70">
          Let’s explore how we can work together to promote talent, innovation,
          and an entrepreneurial culture among Kenyan youth.
        </p>
        <Button href={site.partnerHref} class="mt-8">
          Start a conversation
        </Button>
      </div>
      <div class="group">
        <Image
          src={team}
          alt="Four Zinduka Hub members wearing their community T-shirts"
          widths={[600, 900, 1200]}
          sizes="(max-width: 767px) 95vw, 50vw"
          width={1000}
          class="block w-full grayscale transition-[filter] duration-200 motion-reduce:transition-none [@media(hover:hover)_and_(pointer:fine)]:group-hover:grayscale-0"
        />
      </div>
    </div>
    <div class="flex flex-col items-start justify-between gap-8 border-t border-ink/15 pt-10 sm:flex-row sm:items-center sm:gap-16">
      <div class="max-w-xl">
        <h3 class="font-heading text-[30px] leading-tight tracking-[-0.025em] text-brand">
          Supported by AIESEC
        </h3>
        <p class="mt-3 text-sm leading-7 text-ink/70">
          AIESEC supports Zinduka Hub as a partner in our work to promote
          talent, innovation, and an entrepreneurial culture among young people
          at Chuka University.
        </p>
      </div>
      <Image
        src={poweredBy}
        alt="Powered by AIESEC"
        width={180}
        class="w-[180px] shrink-0"
      />
    </div>
  </div>
</section>
