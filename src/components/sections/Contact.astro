---
import ContactForm from '../ui/ContactForm.astro';
import Icon from '../ui/Icon.astro';
import { site } from '../../data/site';
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class="scroll-mt-6 bg-brand px-6 py-16 text-white sm:px-10 sm:py-20 lg:py-24"
>
  <div class="mx-auto grid max-w-page gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
    <div>
      <h2 id="contact-heading" class="heading-1">
        Good things begin with a conversation.
      </h2>
      <p class="mt-6 max-w-prose text-base leading-8 text-white/80">
        Whether you want to take part or support the work, send us a message and
        we will get back to you.
      </p>
      <ul class="mt-8 flex flex-col items-start gap-3 text-sm">
        <li>
          <a
            href={`mailto:${site.email}`}
            class="flex items-center gap-3 text-white/80 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white motion-reduce:transition-none"
          >
            <Icon name="email" size={17} />
            {site.email}
          </a>
        </li>
        <li class="flex items-center gap-3 text-white/70">
          <Icon name="location" size={17} />
          Chuka University, Kenya
        </li>
      </ul>
    </div>

    <ContactForm />
  </div>
</section>
