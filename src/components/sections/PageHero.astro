---
interface Props {
  id?: string;
  title: string;
  intro?: string;
  class?: string;
}
const { id = 'page-heading', title, intro, class: className } = Astro.props;
---

<section
  aria-labelledby={id}
  class:list={[
    'bg-paper px-6 pt-32 pb-12 sm:px-10 sm:pt-36 sm:pb-16',
    className,
  ]}
>
  <div class="mx-auto max-w-page">
    <h1 id={id} class="max-w-3xl heading-display text-brand">
      {title}
    </h1>
    {intro && (
      <p class="mt-5 max-w-prose text-base leading-8 font-medium text-ink/70">
        {intro}
      </p>
    )}
  </div>
</section>
