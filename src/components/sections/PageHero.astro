---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  class?: string;
}
const {
  id = 'page-heading',
  eyebrow,
  title,
  intro,
  class: className,
} = Astro.props;
---

<section
  aria-labelledby={id}
  class:list={[
    'bg-paper px-6 pt-32 pb-12 sm:px-10 sm:pt-36 sm:pb-16',
    className,
  ]}
>
  <div class="mx-auto max-w-[1120px]">
    {eyebrow && (
      <p class="font-ui text-[11px] font-medium tracking-[0.22em] text-brand uppercase">
        {eyebrow}
      </p>
    )}
    <h1
      id={id}
      class="mt-4 max-w-3xl font-heading text-[42px] leading-[1.05] font-normal tracking-[-0.04em] text-brand sm:text-[60px] lg:text-[72px]"
    >
      {title}
    </h1>
    {intro && (
      <p class="mt-5 max-w-2xl text-base leading-8 font-medium text-ink/70">
        {intro}
      </p>
    )}
  </div>
</section>
