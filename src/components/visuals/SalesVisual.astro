---
import Icon from '../ui/Icon.astro';

const panel =
  'relative flex aspect-[4/3] w-full items-center justify-center overflow-hidden rounded-md border border-ink/10 bg-paper p-8 sm:p-10';
const card = 'w-full max-w-sm rounded-md border border-ink/10 bg-white p-6';
---

<div class={panel} aria-hidden="true">
  <div class={card}>
    <div class="flex h-24 items-end gap-3">
      <div class="grow bg-tint rise" style="height: 42%"></div>
      <div class="grow bg-tint-mid rise" style="height: 62%"></div>
      <div class="grow bg-tint-deep rise" style="height: 80%"></div>
      <div class="grow bg-brand rise" style="height: 100%"></div>
    </div>
    <div class="mt-3 grid grid-cols-4 gap-3 font-ui text-xs text-ink/50">
      <span>Intro</span>
      <span>Pitch</span>
      <span>Terms</span>
      <span class="stamp text-brand">Signed</span>
    </div>
    <div class="mt-5 flex items-center gap-3 border-t border-ink/10 pt-5">
      <span class="ping text-brand">
        <Icon name="check" size={18} />
      </span>
      <p class="font-ui text-xs font-medium text-ink">
        Offer accepted, on your terms
      </p>
    </div>
  </div>
</div>

<style>
  .rise {
    transform-origin: bottom;
    animation: rise 3.2s cubic-bezier(0.23, 1, 0.32, 1) infinite;
  }
  .rise:nth-child(2) {
    animation-delay: 0.18s;
  }
  .rise:nth-child(3) {
    animation-delay: 0.36s;
  }
  .rise:nth-child(4) {
    animation-delay: 0.54s;
  }
  .ping {
    display: inline-flex;
    animation: ping 3s cubic-bezier(0.23, 1, 0.32, 1) infinite;
  }
  .stamp {
    animation: stamp 4s ease-in-out infinite;
  }

  @keyframes rise {
    0%,
    100% {
      transform: scaleY(0.3);
      opacity: 0.55;
    }
    45%,
    65% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @keyframes ping {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.7;
    }
    40% {
      transform: scale(1.25);
      opacity: 1;
    }
  }

  @keyframes stamp {
    0%,
    10% {
      opacity: 0;
      transform: translateY(4px);
    }
    25%,
    80% {
      opacity: 1;
      transform: translateY(0);
    }
    100% {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise,
    .ping,
    .stamp {
      animation: none;
    }
  }
</style>
