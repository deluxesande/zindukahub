---
import Icon from '../ui/Icon.astro';

const panel =
  'relative flex aspect-[4/3] w-full items-center justify-center overflow-hidden rounded-md border border-ink/10 bg-paper p-8 sm:p-10';
const card = 'w-full max-w-sm rounded-md border border-ink/10 bg-white p-6';
---

<div class={panel} aria-hidden="true">
  <div class={card}>
    <div class="flex items-center gap-3">
      <span class="flex size-10 items-center justify-center rounded-full bg-brand/10 text-brand">
        <Icon name="hashtag" size={18} />
      </span>
      <div>
        <p class="font-ui text-xs font-medium text-ink">Your work, your name</p>
        <p class="font-ui text-xs text-ink/50">@yourhandle</p>
      </div>
    </div>
    <div class="mt-6 grid grid-cols-3 gap-2">
      <div class="tile flex aspect-square items-end rounded-sm bg-tint p-2">
        <span class="font-ui text-xs text-ink/60">Post</span>
      </div>
      <div class="tile flex aspect-square items-end rounded-sm bg-tint-mid p-2">
        <span class="font-ui text-xs text-ink/60">Reel</span>
      </div>
      <div class="tile flex aspect-square items-end rounded-sm bg-tint-deep p-2">
        <span class="font-ui text-xs text-ink/70">Story</span>
      </div>
    </div>
    <p class="mt-5 font-ui text-xs leading-6 text-ink/50">
      One voice across every channel.
    </p>
  </div>
</div>

<style>
  .tile {
    animation: lift 3s cubic-bezier(0.23, 1, 0.32, 1) infinite;
  }
  .tile:nth-child(2) {
    animation-delay: 0.25s;
  }
  .tile:nth-child(3) {
    animation-delay: 0.5s;
  }
  .tile,
  .rise,
  .row,
  .clause,
  .ping,

  @keyframes lift {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    45% {
      transform: translateY(-12px) scale(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile {
      animation: none;
    }
  }
</style>
