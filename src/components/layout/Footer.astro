---
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import { footerNav, site } from '../../data/site';
---

<footer class="bg-ink px-6 pt-16 pb-8 text-white sm:px-10">
  <div class="mx-auto max-w-page">
    <div class="grid gap-12 pb-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.1fr] lg:gap-10">
      <div>
        <a
          href="/"
          aria-label="Zinduka Hub home"
          class="inline-block rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
        >
          <Logo inverted class="w-16" />
        </a>
        <p class="mt-5 max-w-[280px] text-sm leading-7 text-white/70">
          Promoting talent, innovation, and an entrepreneurial culture among the
          youth by giving them a platform to showcase their work.
        </p>
      </div>

      {footerNav.map((group) => (
        <nav aria-label={group.title}>
          <h2 class="mb-5 font-ui text-sm font-medium text-white">
            {group.title}
          </h2>
          <ul class="flex flex-col items-start gap-3">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-white/70 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white motion-reduce:transition-none"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}

      <div>
        <h2 class="mb-5 font-ui text-sm font-medium text-white">
          Get in touch
        </h2>
        <ul class="flex flex-col items-start gap-3 text-sm">
          <li>
            <a
              href={`mailto:${site.email}`}
              class="flex items-center gap-3 text-white/70 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white motion-reduce:transition-none"
            >
              <Icon name="email" size={17} />
              {site.email}
            </a>
          </li>
          <li class="flex items-center gap-3 text-white/70">
            <Icon name="location" size={17} />
            Chuka University, Kenya
          </li>
        </ul>
        <div class="mt-6">
          <SocialLinks tone="light" />
        </div>
      </div>
    </div>

    <div class="flex flex-col justify-between gap-3 border-t border-white/10 pt-6 text-xs text-white/60 sm:flex-row">
      <p>
        © {new Date().getFullYear()} Zinduka Hub. Powered by AIESEC in Chuka
        University.
      </p>
      <p>Create. Exhibit. Enterprise.</p>
    </div>
  </div>
</footer>
