---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import talent from '../../assets/images/talent.png';
import innovation from '../../assets/images/innovation.png';
import leadership from '../../assets/images/leadership.png';
import entrepreneurship from '../../assets/images/entrepreneurship.png';
import type { focusAreas } from '../../data/site';

type Area = (typeof focusAreas)[number];
interface Props {
  area: Area;
}
const { area } = Astro.props;
const treatments = {
  talent: 'bg-tint text-brand',
  innovation: 'bg-brand text-white',
  leadership: 'bg-tint-mid text-brand',
  entrepreneurship: 'bg-tint-deep text-ink',
};
const artwork = {
  talent: {
    field:
      '-bottom-36 -left-12 h-64 w-[125%] -rotate-12 rounded-[50%] bg-brand',
    loop: 'right-5 bottom-7 h-48 w-40 rotate-[24deg] border-tint-deep',
    stroke: '-right-8 bottom-6 w-56 -rotate-12 border-paper/80',
  },
  innovation: {
    field: '-right-12 -bottom-28 h-80 w-80 rounded-full bg-tint-deep',
    loop: 'left-8 -bottom-24 h-64 w-48 -rotate-[32deg] border-tint/65',
    stroke: '-right-4 bottom-5 w-64 -rotate-12 border-paper/80',
  },
  leadership: {
    field: '-bottom-36 -left-12 h-72 w-[125%] rotate-12 rounded-[50%] bg-ink',
    loop: 'right-9 bottom-6 h-52 w-36 rotate-[25deg] border-brand/70',
    stroke: '-left-6 bottom-8 w-64 rotate-12 border-tint-deep',
  },
  entrepreneurship: {
    field:
      '-bottom-36 -left-16 h-72 w-[130%] -rotate-12 rounded-[50%] bg-brand',
    loop: 'right-10 -bottom-8 h-64 w-44 -rotate-[28deg] border-tint/80',
    stroke: '-right-5 bottom-7 w-64 -rotate-12 border-paper/80',
  },
};
const art = artwork[area.treatment];
const photos: Record<Area['treatment'], { src: ImageMetadata; width: string }> =
  {
    talent: { src: talent, width: 'w-[75%] sm:w-[60%]' },
    innovation: { src: innovation, width: 'w-[80%] sm:w-[65%]' },
    leadership: { src: leadership, width: 'w-[85%] sm:w-[70%]' },
    entrepreneurship: { src: entrepreneurship, width: 'w-[80%] sm:w-[65%]' },
  };
const photo = photos[area.treatment];
---

<article
  class:list={[
    'group relative isolate min-h-[290px] overflow-hidden rounded-md p-6 sm:min-h-[310px] sm:p-8',
    treatments[area.treatment],
  ]}
>
  <div
    aria-hidden="true"
    class:list={['pointer-events-none absolute', art.field]}
  ></div>
  <div
    aria-hidden="true"
    class:list={[
      'pointer-events-none absolute rounded-[50%] border-[3px]',
      art.loop,
    ]}
  ></div>
  <h3 class="relative z-10 heading-2">{area.title}</h3>
  <Image
    src={photo.src}
    alt=""
    widths={[480, 800, 1100]}
    sizes="(max-width: 767px) 70vw, 32vw"
    width={900}
    class:list={[
      'absolute right-0 bottom-0 h-auto grayscale transition-[filter] duration-200 motion-reduce:transition-none [@media(hover:hover)_and_(pointer:fine)]:group-hover:grayscale-0',
      photo.width,
    ]}
  />
  <div
    aria-hidden="true"
    class:list={[
      'pointer-events-none absolute h-7 rounded-[50%] border-[4px]',
      art.stroke,
    ]}
  ></div>
</article>
