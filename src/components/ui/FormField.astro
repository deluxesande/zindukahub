---
interface Props {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'textarea';
  autocomplete?: string;
  required?: boolean;
  maxLength?: number;
}
const {
  name,
  label,
  type = 'text',
  autocomplete,
  required = true,
  maxLength = 200,
} = Astro.props;
const fieldClass =
  'mt-2 block w-full rounded-sm border border-white/35 bg-white/5 px-4 py-3 text-base text-white transition-colors duration-150 focus:border-white focus:bg-white/10 focus:outline-2 focus:outline-offset-2 focus:outline-white motion-reduce:transition-none';
---

<div>
  <label for={`contact-${name}`} class="text-sm font-medium">
    {label}
    {!required && <span class="ml-1 text-white/60">(optional)</span>}
  </label>
  {type === 'textarea' ? (
    <textarea
      id={`contact-${name}`}
      {name}
      {required}
      maxlength={maxLength}
      rows={5}
      class:list={[fieldClass, 'min-h-36 resize-y']}
    ></textarea>
  ) : (
    <input
      id={`contact-${name}`}
      {name}
      {type}
      {autocomplete}
      {required}
      maxlength={maxLength}
      class={fieldClass}
    />
  )}
</div>
