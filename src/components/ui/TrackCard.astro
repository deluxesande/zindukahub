---
import Icon from './Icon.astro';
import type { Track } from '../../data/zinduka11';

interface Props {
  track: Track;
}
const { track } = Astro.props;
---

<article class="flex flex-col gap-4 rounded-md border border-ink/10 bg-white p-7 shadow-sm shadow-black/[0.02]">
  <span class="flex size-11 items-center justify-center rounded-full bg-brand/10 text-brand">
    <Icon name={track.icon} size={22} />
  </span>
  <h3 class="font-heading text-[26px] leading-tight font-normal tracking-[-0.03em] text-ink">
    {track.title}
  </h3>
  <p class="text-sm leading-7 text-ink/70">{track.copy}</p>
</article>
