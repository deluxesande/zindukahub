---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  poster: ImageMetadata;
  alt: string;
  ratio?: string;
  class?: string;
}
const { poster, alt, ratio = 'aspect-[4/5]', class: className } = Astro.props;
---

<div class:list={[ratio, 'relative overflow-hidden', className]}>
  <Image
    src={poster}
    alt={alt}
    widths={[400, 700, 1000]}
    sizes="(max-width: 767px) 90vw, 33vw"
    width={800}
    class="h-full w-full object-cover"
  />
</div>
