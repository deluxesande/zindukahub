---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  poster: ImageMetadata | null;
  alt: string;
  label?: string;
  ratio?: string;
  class?: string;
}
const {
  poster,
  alt,
  label = 'Poster coming soon',
  ratio = 'aspect-[4/5]',
  class: className,
} = Astro.props;
---

<div class:list={[ratio, 'relative overflow-hidden', className]}>
  {poster ? (
    <Image
      src={poster}
      alt={alt}
      widths={[400, 700, 1000]}
      sizes="(max-width: 767px) 90vw, 33vw"
      width={800}
      class="h-full w-full object-cover"
    />
  ) : (
    <div
      role="img"
      aria-label={alt}
      class="flex h-full w-full flex-col items-center justify-center gap-2 border-2 border-dashed border-brand/25 bg-brand/[0.04] p-6 text-center"
    >
      <span class="font-ui text-[10px] font-medium tracking-[0.18em] text-brand/70 uppercase">
        Placeholder
      </span>
      <span class="font-heading text-lg leading-snug text-brand/70">
        {label}
      </span>
    </div>
  )}
</div>
