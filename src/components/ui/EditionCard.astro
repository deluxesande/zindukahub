---
import { Image } from 'astro:assets';
import type { Edition } from '../../data/history';

interface Props {
  edition: Edition;
  featured?: boolean;
}
const { edition, featured = false } = Astro.props;
---

<article
  class:list={[
    'grid gap-4 md:grid-cols-[190px_1fr] md:gap-10',
    featured
      ? 'rounded-md bg-brand px-6 py-8 text-white sm:px-8'
      : 'border-t border-ink/10 py-8',
  ]}
>
  <div>
    <p
      class:list={[
        'font-heading text-[34px] leading-none tracking-[-0.03em]',
        featured ? 'text-white' : 'text-brand',
      ]}
    >
      Zinduka {edition.edition}.0
    </p>
    <p
      class:list={[
        'mt-3 font-ui text-[10px] font-medium tracking-[0.18em] uppercase',
        featured ? 'text-white/70' : 'text-ink/45',
      ]}
    >
      {edition.year}
    </p>
  </div>
  <div>
    <p
      class:list={[
        'font-ui text-[11px] font-medium tracking-[0.18em] uppercase',
        featured ? 'text-white/80' : 'text-brand',
      ]}
    >
      {edition.theme}
    </p>
    <h3
      class:list={[
        'mt-2 font-heading text-[26px] leading-tight tracking-[-0.03em]',
        featured ? 'text-white' : 'text-ink',
      ]}
    >
      {edition.title}
    </h3>
    <p
      class:list={[
        'mt-3 max-w-2xl text-sm leading-7',
        featured ? 'text-white/80' : 'text-ink/70',
      ]}
    >
      {edition.description}
    </p>
    {edition.image && (
      <Image
        src={edition.image}
        alt={`${edition.title} artwork`}
        widths={[600, 900, 1200]}
        sizes="(max-width: 767px) 90vw, 60vw"
        width={1000}
        class="mt-5 w-full rounded-md"
      />
    )}
  </div>
</article>
