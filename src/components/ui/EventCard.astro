---
import Icon from './Icon.astro';
import Button from './Button.astro';
import PosterSlot from './PosterSlot.astro';
import type { EventItem } from '../../data/events';

interface Props {
  event: EventItem;
}
const { event } = Astro.props;
const isUpcoming = event.status === 'upcoming';
---

<article class="group grid overflow-hidden rounded-md border border-ink/10 bg-white shadow-sm shadow-black/[0.02] md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.4fr)]">
  <PosterSlot
    poster={event.poster}
    alt={`${event.title} poster`}
    ratio="aspect-[4/5]"
    class="border-b border-ink/10 md:border-b-0 md:border-r"
  />
  <div class="flex flex-col gap-4 p-6 sm:p-8">
    <div class="flex flex-wrap items-center gap-3">
      {event.track && (
        <span class="font-ui text-xs font-medium text-brand">
          {event.track}
        </span>
      )}
      {!isUpcoming && (
        <span class="font-ui text-xs font-medium text-ink/45">Past event</span>
      )}
    </div>
    <h3 class="heading-2 text-ink">
      <a
        href={`/events/${event.slug}`}
        class="transition-colors hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand motion-reduce:transition-none"
      >
        {event.title}
      </a>
    </h3>
    <ul class="space-y-2 text-sm text-ink/70">
      <li class="flex items-center gap-3">
        <Icon name="calendar" size={17} class="text-brand" />
        <span>
          {event.date}
          {event.time && ` · ${event.time}`}
        </span>
      </li>
      <li class="flex items-center gap-3">
        <Icon name="venue" size={17} class="text-brand" />
        <span>{event.location}</span>
      </li>
    </ul>
    <p class="text-sm leading-7 text-ink/70">{event.description}</p>
    {isUpcoming && (
      <Button
        href={event.bookingUrl}
        icon="arrowRight"
        external
        class="mt-2 w-fit"
      >
        Book on our events platform
      </Button>
    )}
  </div>
</article>
